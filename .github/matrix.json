{
  "include": [
    {
      "os": "ubuntu-latest",
      "platform": "linux-x86_64"
    },
    {
      "os": "macos-latest",
      "platform": "macos-universal",
      "make-args": "ARCHFLAGS=\"-arch arm64 -arch x86_64\""
